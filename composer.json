{
    "name": "sandermuller/census",
    "description": "Counts what an application's Eloquent models hold, and reports it, without configuring a single metric.",
    "keywords": [
        "sandermuller",
        "laravel",
        "eloquent",
        "stats",
        "dashboard"
    ],
    "homepage": "https://github.com/sandermuller/census",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Sander Muller",
            "email": "sander.muller@dias.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0"
    },
    "autoload": {
        "psr-4": {
            "SanderMuller\\Census\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SanderMuller\\Census\\CensusServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "driftingly/rector-laravel": "^2.6",
        "larastan/larastan": "^3.11",
        "laravel/boost": "^2.7",
        "laravel/pint": "^1.30",
        "nunomaduro/collision": "^8.9",
        "orchestra/testbench": "^11.2",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.3",
        "rector/rector": "^2.6",
        "sandermuller/boost-skills": "^2.38",
        "sandermuller/package-boost-laravel": "^1.1",
        "spaze/phpstan-disallowed-calls": "^4.14",
        "symplify/phpstan-rules": "^14.13",
        "tomasvotruba/cognitive-complexity": "^1.2",
        "tomasvotruba/type-coverage": "^2.3"
    },
    "autoload-dev": {
        "psr-4": {
            "SanderMuller\\Census\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=2G",
        "format": "vendor/bin/pint",
        "rector": "vendor/bin/rector process",
        "test": "vendor/bin/phpunit",
        "qa": [
            "@rector",
            "@format",
            "@phpstan"
        ],
        "qa-check": [
            "vendor/bin/rector process --dry-run",
            "vendor/bin/pint --test",
            "@phpstan",
            "@test"
        ]
    }
}
